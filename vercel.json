    },
    {
      "source": "/services/deck-facelift",
      "destination": "/services/deck-resurfacing",
      "permanent": true
    },
    {
      "source": "/services/custom-decks",
      "destination": "/services/new-deck-builds",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/potomac",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/north-potomac-kentlands",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/bethesda",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/olney",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/boyds",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/clarksburg",
      "destination": "/estimate",
      "permanent": true
    },
    {
      "source": "/towns/:slug*",
      "destination": "/estimate",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/colors-catalog/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/colors-catalog/"
        }
      ]
    }
  ]
}
